{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerfTelemetry",
  "description": "Performance telemetry for one build, aggregated over its sessions. telemetry/perf/<build_id>.json. Regression baseline: the last 10 clean builds, per level and platform.",
  "type": "object",
  "required": [
    "build_id",
    "app_version",
    "platform",
    "source",
    "sessions",
    "frame_time_ms",
    "frame_time_ms_p50",
    "frame_time_ms_p95",
    "frame_time_ms_p99",
    "load_time_ms",
    "load_time_ms_p50",
    "load_time_ms_p95",
    "levels",
    "by_device_family",
    "hot_path"
  ],
  "properties": {
    "build_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "e.g. 1038"
    },
    "app_version": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "web"
      ],
      "description": "android in Round 1; web is added in Round 2"
    },
    "source": {
      "const": "mock",
      "description": "Records without source=mock did not come from the mock repo; reject them"
    },
    "sessions": {
      "type": "integer",
      "minimum": 1
    },
    "frame_time_ms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "frame_time_ms_p50": {
      "type": "number",
      "minimum": 0
    },
    "frame_time_ms_p95": {
      "type": "number",
      "minimum": 0
    },
    "frame_time_ms_p99": {
      "type": "number",
      "minimum": 0
    },
    "load_time_ms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      },
      "description": "Time to first playable frame, per sampled session"
    },
    "load_time_ms_p50": {
      "type": "number",
      "minimum": 0
    },
    "load_time_ms_p95": {
      "type": "number",
      "minimum": 0
    },
    "levels": {
      "type": "object",
      "patternProperties": {
        "^area-[0-7]$": {
          "type": "object",
          "required": [
            "frame_time_ms",
            "frame_time_ms_p50",
            "frame_time_ms_p95",
            "frame_time_ms_p99",
            "frames_sampled",
            "hitch_count",
            "hitch_pct",
            "memory_mb_peak",
            "memory_mb_peak_p95"
          ],
          "properties": {
            "frame_time_ms": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "description": "Sample of per-frame times"
            },
            "frame_time_ms_p50": {
              "type": "number",
              "minimum": 0
            },
            "frame_time_ms_p95": {
              "type": "number",
              "minimum": 0
            },
            "frame_time_ms_p99": {
              "type": "number",
              "minimum": 0
            },
            "frames_sampled": {
              "type": "integer",
              "minimum": 1
            },
            "hitch_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Frames over 33.3 ms among frames_sampled"
            },
            "hitch_pct": {
              "type": "number",
              "minimum": 0
            },
            "memory_mb_peak": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "memory_mb_peak_p95": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "by_device_family": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tier",
          "sessions",
          "frame_time_ms_p95",
          "memory_mb_peak_p95"
        ],
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high"
            ]
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          },
          "frame_time_ms_p95": {
            "type": "number"
          },
          "memory_mb_peak_p95": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "hot_path": {
      "type": "object",
      "properties": {
        "frame_time_ms": {
          "type": "object",
          "required": [
            "file",
            "function"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "function": {
              "type": "string"
            },
            "self_time_pct": {
              "type": "number"
            },
            "retained_mb": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "memory_mb": {
          "type": "object",
          "required": [
            "file",
            "function"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "function": {
              "type": "string"
            },
            "self_time_pct": {
              "type": "number"
            },
            "retained_mb": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "load_time_ms": {
          "type": "object",
          "required": [
            "file",
            "function"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "function": {
              "type": "string"
            },
            "self_time_pct": {
              "type": "number"
            },
            "retained_mb": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
